# Copie para .env. Nunca coloque DATABASE_URL em variável VITE_ nem envie segredos pelo chat.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA-CHAVE-PUBLICA-ANON-OU-PUBLISHABLE
VITE_WINDOWS_DOWNLOAD_URL=https://SEU-CDN-ou-release/Mythreon-Online-Windows-x64.exe
VITE_ANDROID_DOWNLOAD_URL=https://SEU-CDN-ou-release/Mythreon-Online-Android.apk
# Na web use /api/world; no executável Windows use a URL HTTPS completa.
VITE_WORLD_API_URL=/api/world
# Opcional, apenas para desenvolvimento do executável. Em produção o launcher usa o manifesto padrão do site.
MYTHREON_UPDATE_MANIFEST_URL=https://mythreon-online.vercel.app/downloads/latest.json
# Apenas servidor/Vercel. Use a string do pooler de transações (porta 6543) do Supabase.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:6543/postgres
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA-CHAVE-PUBLICA-ANON-OU-PUBLISHABLE
WORLD_ALLOWED_ORIGINS=https://mythreon-online.vercel.app,mythreon://game,http://localhost:5173,http://127.0.0.1:5173
# Apenas servidor/Vercel. Segredo compartilhado com o provedor de checkout;
# nunca exponha este valor em VITE_ ou no navegador.
MYTHREON_PREMIUM_WEBHOOK_SECRET=troque-por-um-segredo-longo-e-aleatorio
