# Copie para .env. Nunca coloque DATABASE_URL em variável VITE_ nem envie segredos pelo chat.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA-CHAVE-PUBLICA-ANON-OU-PUBLISHABLE
# Na web use /api/world; no executável Windows use a URL HTTPS completa.
VITE_WORLD_API_URL=/api/world
# Apenas servidor/Vercel. Use a string do pooler de transações (porta 6543) do Supabase.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:6543/postgres
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA-CHAVE-PUBLICA-ANON-OU-PUBLISHABLE
WORLD_ALLOWED_ORIGINS=https://mythreon-online.vercel.app,mythreon://game,http://localhost:5173,http://127.0.0.1:5173
