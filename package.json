{
  "name": "mythreon-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/mythreon-brain.mjs --dev",
    "brain:sync": "node scripts/mythreon-brain.mjs --once",
    "brain:watch": "node scripts/brain-service.mjs",
    "brain:seal": "node scripts/mythreon-brain.mjs --once --seal",
    "brain:open": "node scripts/mythreon-brain.mjs --open",
    "prebuild": "node scripts/mythreon-brain.mjs --once",
    "build": "npm run online:bundle && vite build",
    "preview": "vite preview",
    "desktop:start": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --win --dir --x64",
    "desktop:portable": "npm run build && electron-builder --win portable --x64",
    "brain:check": "node scripts/brain-check.mjs",
    "balance:check": "node scripts/balance-audit.cjs --check",
    "journey:check": "node scripts/journey-check.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "online:check": "node scripts/run-ts-check.cjs scripts/online-check.ts",
    "professions:check": "node scripts/run-ts-check.cjs scripts/professions-check.ts",
    "professions:pulse-check": "node scripts/run-ts-check.cjs scripts/profession-challenge-check.ts",
    "professions:bait-check": "node scripts/run-ts-check.cjs scripts/professions-bait-check.ts",
    "calendar:check": "node scripts/run-ts-check.cjs scripts/calendar-check.ts",
    "cosmetics:check": "node scripts/run-ts-check.cjs scripts/cosmetics-check.ts",
    "cards:check": "node scripts/run-ts-check.cjs scripts/cards-check.ts",
    "online:session-check": "node scripts/run-ts-check.cjs scripts/online-session-check.ts",
    "online:dev": "tsx scripts/world-dev.ts",
    "online:doctor": "node scripts/online-doctor.mjs",
    "online:bundle": "node scripts/build-online-runtime.mjs",
    "online:bundle-check": "node scripts/build-online-runtime.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "pg": "^8.23.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "ws": "^8.22.1"
  },
  "main": "desktop/main.cjs",
  "description": "Mythreon Online — RPG idle de fantasia arcana",
  "author": "Mythreon Online"
}
