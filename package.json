{
  "name": "mythreon-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/mythreon-brain.mjs --dev",
    "brain:sync": "node scripts/mythreon-brain.mjs --once",
    "brain:watch": "node scripts/mythreon-brain.mjs --watch",
    "brain:seal": "node scripts/mythreon-brain.mjs --once --seal",
    "brain:open": "node scripts/mythreon-brain.mjs --open",
    "prebuild": "node scripts/mythreon-brain.mjs --once",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:start": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --win --dir --x64",
    "desktop:portable": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "main": "desktop/main.cjs",
  "description": "Mythreon Online — RPG idle de fantasia arcana",
  "author": "Mythreon Online"
}
